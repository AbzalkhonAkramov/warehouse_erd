# --- Database ---
DATABASE_URL=postgresql+asyncpg://erp:erp@localhost:5432/erp

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- App ---
PROJECT_NAME=Warehouse ERP
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins (web app, etc.)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Telegram notifications (optional in dev) ---
TELEGRAM_BOT_TOKEN=
# Default chat/channel id for manager alerts
TELEGRAM_MANAGER_CHAT_ID=
